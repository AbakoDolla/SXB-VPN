diff --git a/.github/workflows/build-android.yml b/.github/workflows/build-android.yml
index b9c448d..347d58f 100644
--- a/.github/workflows/build-android.yml
+++ b/.github/workflows/build-android.yml
@@ -86,6 +86,19 @@ jobs:
           restore-keys: |
             android-gradle-v5-${{ runner.os }}-
 
+      # ── E3 — Extraire versionCode / versionName depuis app.json ───────────────
+      # Exposés en variables d'environnement du job pour être utilisés par le
+      # step qui écrit /var/www/apk/version.json (endpoint /xapi/mobile/app-version).
+      - name: Extraire versionCode / versionName (app.json)
+        id: appmeta
+        run: |
+          VN=$(node -p "require('./app.json').expo.version")
+          VC=$(node -p "require('./app.json').expo.android.versionCode")
+          echo "APP_VERSION_NAME=$VN" >> "$GITHUB_ENV"
+          echo "APP_VERSION_CODE=$VC" >> "$GITHUB_ENV"
+          echo "APK_PUBLIC_URL=https://vpnsxb.afrihall.com/apk/sxbvpn-latest.apk" >> "$GITHUB_ENV"
+          echo "[appmeta] versionName=$VN versionCode=$VC"
+
       # ── Expo prebuild — TOUJOURS (régénère build.gradle propre à chaque run) ──
       # Sans --clean : préserve les artefacts Gradle dans android/app/build/
       # Sans la condition cache-hit : garantit un build.gradle vierge avant les
@@ -468,14 +481,43 @@ jobs:
           host: 141.95.112.93
           username: ubuntu
           password: ${{ secrets.VPS_SSH_PASSWORD }}
+          # Variables lues côté runner puis passées à SSH via envs (les
+          # substitutions ${{ }} sont interpolées dans le YAML avant l'exécution
+          # du script distant — c'est ce qu'on veut).
+          envs: RUN_NUMBER,APP_VERSION_NAME,APP_VERSION_CODE,APK_PUBLIC_URL,COMMIT_SHA
           script: |
             sudo mkdir -p /var/www/apk
             if [ -f /tmp/sxb-vpn.apk ]; then
               sudo cp /tmp/sxb-vpn.apk /var/www/apk/sxbvpn-latest.apk
-              sudo cp /tmp/sxb-vpn.apk "/var/www/apk/sxbvpn-build-${{ github.run_number }}.apk"
-              echo "✅ Déployé: $(ls -lh /var/www/apk/sxbvpn-latest.apk)"
+              sudo cp /tmp/sxb-vpn.apk "/var/www/apk/sxbvpn-build-${RUN_NUMBER}.apk"
+              echo "✅ APK déployé: $(ls -lh /var/www/apk/sxbvpn-latest.apk)"
+
+              # ── E3 — Écrire version.json à côté de l'APK ───────────────────
+              # Ce fichier est la source de vérité de l'endpoint public
+              # GET /xapi/mobile/app-version : l'app mobile compare son
+              # versionCode installé et propose la mise à jour si différent.
+              # Signature stable ⇒ install in-place, données conservées.
+              PUBLISHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+              sudo tee /var/www/apk/version.json > /dev/null <<VJSON
+              {
+                "versionCode": ${APP_VERSION_CODE},
+                "versionName": "${APP_VERSION_NAME}",
+                "apkUrl": "${APK_PUBLIC_URL}",
+                "publishedAt": "${PUBLISHED_AT}",
+                "commit": "${COMMIT_SHA}",
+                "runNumber": ${RUN_NUMBER}
+              }
+              VJSON
+              sudo chmod 644 /var/www/apk/version.json
+              echo "✅ version.json publié: $(cat /var/www/apk/version.json)"
             else
               echo "⚠️  /tmp/sxb-vpn.apk absent — scp a peut-être échoué"
               ls /tmp/*.apk 2>/dev/null || true
             fi
+        env:
+          RUN_NUMBER:       ${{ github.run_number }}
+          APP_VERSION_NAME: ${{ env.APP_VERSION_NAME }}
+          APP_VERSION_CODE: ${{ env.APP_VERSION_CODE }}
+          APK_PUBLIC_URL:   ${{ env.APK_PUBLIC_URL }}
+          COMMIT_SHA:       ${{ github.sha }}
         continue-on-error: true
