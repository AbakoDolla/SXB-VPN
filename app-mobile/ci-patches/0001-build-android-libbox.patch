+  SING_BOX_VERSION: v1.11.15
+
 jobs:
   build-android:
     name: Build Android APK
@@ -70,6 +74,43 @@ jobs:
             echo "[patch] Déjà appliqué ou expo-modules-core absent (normal si cache node)"
