+      # ══════════════════════════════════════════════════════════════════════════
+      # MOTEUR VPN — libbox.aar (sing-box in-process)
+      # ══════════════════════════════════════════════════════════════════════════
+      # Remplace l'ancien binaire sing-box exécuté par ProcessBuilder, qui ne
+      # pouvait pas fonctionner : Android 10+ interdit l'exécution depuis le
+      # répertoire privé de l'app (W^X), et le CLI ne sait pas recevoir le
+      # descripteur du TUN (le champ JSON `file_descriptor` n'existe pas —
+      # il n'est peuplé que par l'API Go libbox).
+      #
+      # La compilation prend ~10 min, on la met donc en cache sur la version.
+      - name: Setup Go 1.23
+        uses: actions/setup-go@v5
+        with:
+          go-version: "1.23"
+          cache: false
+
+      - name: Cache libbox.aar
+        id: cache-libbox
+        uses: actions/cache@v4
+        with:
+          path: app-mobile/libs/libbox.aar
+          key: libbox-aar-${{ env.SING_BOX_VERSION }}-${{ hashFiles('app-mobile/scripts/build-libbox.sh') }}
+
+      - name: Build libbox.aar (sing-box)
+        if: steps.cache-libbox.outputs.cache-hit != 'true'
+        run: ./scripts/build-libbox.sh
+        env:
+          ANDROID_HOME: /usr/local/lib/android/sdk
+
+      - name: Vérifier la présence de libbox.aar
+        run: |
+          if [ ! -f libs/libbox.aar ]; then
+            echo "::error::libs/libbox.aar introuvable après l'étape de build"
+            exit 1
+          fi
+          echo "✅ libbox.aar prêt ($(du -h libs/libbox.aar | cut -f1))"
+
       # ── Cache Gradle build artifacts uniquement (pas android/app/build.gradle) ──
       # IMPORTANT : on ne cache PAS le dossier android/ complet car build.gradle
       # est modifié par les steps suivants (signing, packaging). Mettre ce fichier
@@ -169,6 +210,14 @@ jobs:
             '-keep class com.sxbvpn.** { *; }' \
             '-keepclassmembers class com.sxbvpn.** { *; }' \
             '-keepattributes Signature,*Annotation*,EnclosingMethod,InnerClasses' \
+            '# Moteur sing-box embarqué (libbox / gomobile)' \
+            '# Go appelle ces classes par réflexion : sans ces règles, R8 les' \
