datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  status       String       @default("active") // active, suspended
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vpnClients   VpnClient[]
  resellerInfo Reseller?
  auditLogs    AuditLog[]
  adminTokens     AdminToken[]
  supportTickets SupportTicket[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // OWNER (racine, invisible), SUPER_ADMIN, ADMIN, SUPPORT, RESELLER
  description String?
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminToken {
  id        String    @id @default(uuid())
  token     String    @unique // SXB-ADMIN-XXXX-XXXX
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  status    String    @default("active") // active, used, revoked
  createdAt DateTime  @default(now())

  @@map("admin_tokens")
}

model VpnClient {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String     @unique // SXB-USER-XXXX-XXXX-XXXX
  quotaTotal      BigInt?
  quotaUsed       BigInt     @default(0)
  expireAt        DateTime?
  status          String     @default("active") // active, suspended
  avatarUrl       String?
  xpanelUserId    String?    // External xPanel user ID
  deviceLimit     Int        @default(1)
  deviceId        String?    @unique
  activatedAt     DateTime?
  lastSeenAt      DateTime?
  appRegisteredAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tokens       TokenSXB[]

  subscriptions      Subscription[]
  xrayAccounts       XrayAccount[]
  singboxAccounts    SingboxAccount[]
  activationSessions ActivationSession[]
  appRegistrations   AppRegistration[]

  @@map("vpn_clients")
}

model Reseller {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commission     Float    @default(0.0)
  quotaBytes     BigInt   @default(0)
  quotaUsedBytes BigInt   @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedProfiles VpnProfileReseller[]

  @@map("resellers")
}

// Attribution d'une configuration VPN à un revendeur.
//
// L'administrateur importe une configuration UNE FOIS puis coche les
// revendeurs qui la reçoivent ; elle apparaît aussitôt sur leur tableau de
// bord, sans avoir à la recréer ni la reconfigurer.
//
// COMPATIBILITÉ ASCENDANTE : un profil SANS aucune attribution reste visible
// par tous les revendeurs. Les 45 profils déjà en production n'en ont aucune ;
// les restreindre d'office couperait les revendeurs actifs du jour au
// lendemain. L'interface signale ce cas par « Tous les revendeurs ».
model VpnProfileReseller {
  profileId  String
  profile    VpnProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  resellerId String
  reseller   Reseller   @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  assignedAt DateTime   @default(now())
  assignedBy String?

  @@id([profileId, resellerId])
  @@map("vpn_profile_resellers")
}

model TokenSXB {
  id          String    @id @default(uuid())
  token       String    @unique // SXB-DATA-XXXX-XXXX-XXXX
  clientId    String
  client      VpnClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quota       BigInt
  expiration  DateTime
  deviceLimit Int       @default(1)
  status      String    @default("active") // active, used, expired, revoked
  createdAt   DateTime  @default(now())

  @@map("tokens")
}

model VPSServer {
  id            String         @id @default(uuid())
  name          String
  ip            String
  location      String
  status        String         @default("online") // online, offline
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serverConfigs ServerConfig[]

  @@map("servers")
}

model ServerConfig {
  id                     String    @id @default(uuid())
  serverId               String
  server                 VPSServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type                   String
  configurationEncrypted String
  createdAt              DateTime  @default(now())

  @@map("xpanel_configs")
}

model Voucher {
  id           String   @id @default(uuid())
  code         String   @unique // SXB-VOUCH-XXXX
  quota        BigInt
  durationDays Int
  isRedeemed   Boolean  @default(false)
  redeemedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vouchers")
}

model AuditLog {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action           String
  type             String   // info, warning, danger, success
  ipAddress        String?
  timestamp        DateTime @default(now())
  visibleOwnerOnly Boolean  @default(false) // vrai = entrée visible UNIQUEMENT par le rôle OWNER

  @@map("audit_logs")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model SupportTicket {
  id          String   @id @default(uuid())
  title       String
  clientName  String
  description String?
  priority    String   @default("medium") // low, medium, high
  status      String   @default("open") // open, in_progress, resolved, closed
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

// ═══════════════════════════════════════════════════════════════
// SXB VPN CORE — NEW MODULES (added, existing tables preserved)
// ═══════════════════════════════════════════════════════════════

model SshAccount {
  id              String      @id @default(uuid())
  name            String
  host            String
  port            Int         @default(22)
  username        String
  password        String      // AES-256-CBC encrypted
  mode            String      @default("create") // "create" | "import"
  expireAt        DateTime?
  quotaTotal      BigInt?
  quotaUsed       BigInt      @default(0)
  connectionLimit Int         @default(1)
  compression     Boolean     @default(false)
  tcpNodelay      Boolean     @default(true)
  slowDns         Boolean     @default(false)
  dns             String?
  sni             String?
  payloadId       String?
  payload         SshPayload? @relation(fields: [payloadId], references: [id])
  status          String      @default("active") // active | suspended | expired
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("ssh_accounts")
}

model SshPayload {
  id          String       @id @default(uuid())
  name        String
  host        String?
  sni         String?
  port        Int?
  headers     Json?
  content     String?
  status      String       @default("active")
  sshAccounts SshAccount[]
  vpnProfiles VpnProfile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("ssh_payloads")
}

model XrayAccount {
  id         String     @id @default(uuid())
  name       String
  protocol   String     // vless | vmess | trojan | shadowsocks
  uuid       String     @unique @default(uuid())
  host       String
  port       Int
  path       String?
  tls        Boolean    @default(false)
  sni        String?
  network    String?    @default("ws")
  password   String?
  method     String?
  quotaTotal BigInt?
  quotaUsed  BigInt     @default(0)
  expireAt   DateTime?
  maxDevices Int        @default(1)
  status     String     @default("active")
  serverId   String?
  clientId   String?
  client     VpnClient? @relation(fields: [clientId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("xray_accounts")
}

model SingboxAccount {
  id         String     @id @default(uuid())
  name       String
  protocol   String     // vless | trojan | shadowsocks | hysteria2 | tuic
  uuid       String     @unique @default(uuid())
  host       String
  port       Int
  path       String?
  tls        Boolean    @default(true)
  sni        String?
  network    String?    @default("ws")
  password   String?
  method     String?
  quotaTotal BigInt?
  quotaUsed  BigInt     @default(0)
  expireAt   DateTime?
  maxDevices Int        @default(1)
  status     String     @default("active")
  serverId   String?
  clientId   String?
  client     VpnClient? @relation(fields: [clientId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("singbox_accounts")
}

model TrafficUsage {
  id          String   @id @default(uuid())
  clientId    String?
  accountId   String?
  deviceId    String?
  accountType String?  // ssh | xray | singbox
  download    BigInt   @default(0)
  upload      BigInt   @default(0)
  timestamp   DateTime @default(now())

  @@map("traffic_usage")
}

model VpnLog {
  id          String   @id @default(uuid())
  clientId    String?
  accountId   String?
  protocol    String?
  action      String   // connect | disconnect | error
  ipAddress   String?
  details     String?
  timestamp   DateTime @default(now())

  @@map("vpn_logs")
}

// ═══════════════════════════════════════════════════════════════
// SXB VPN OFFLINE-FIRST — VPN Profiles + Subscriptions
// ═══════════════════════════════════════════════════════════════

model VpnProfile {
  id               String         @id @default(uuid())
  name             String
  description      String?
  protocol         String         // ssh | vless | vmess | trojan | shadowsocks | singbox  ← technicalProtocol
  displayProtocol  String?        // Nom commercial affiché sur mobile : "MTN Protocol", "Orange Protocol"
  host             String
  port             Int
  username         String?
  password         String?        // AES-256-CBC encrypted
  uuid             String?        @unique @default(uuid())
  path             String?
  network          String?        @default("ws")
  tls              Boolean        @default(false)
  sni              String?
  dns              String?
  payloadId        String?
  payload          SshPayload?    @relation(fields: [payloadId], references: [id])
  offlineValidDays Int            @default(7)
  method           String?
  jsonConfig       String?        // LEGACY — ne plus écrire en clair ; voir canonicalConfig
  // ── Modèle « intermédiaire d'import » (canonique, chiffré, versionné) ────────
  // Règle : quand canonicalConfig est présent, il est LA SEULE source de vérité
  // technique du profil. Les colonnes host/port/protocol/tls... restent pour
  // identification/affichage et DOIVENT refléter le contenu du canonique.
  sourceFormat       String?      // ssh-json | ssh+payload-json | vless-uri | vmess-uri | trojan-uri | ss-uri | wireguard-conf | hysteria2-uri | tuic-uri | singbox-json | xray-json | sxb-canonical
  canonicalConfig    String?      // AES-256-GCM (préfixe gcm:) — config technique importée, JAMAIS en clair
  canonicalConfigHash String?     // sha256 hex (64) du JSON canonique normalisé
  configVersion      Int          @default(1) // incrémenté à chaque réimport explicite
  importedAt         DateTime?
  validatedAt        DateTime?
  validationStatus   String?      // valid | invalid | unreachable_from_probe | unknown
  validationMessage  String?
  status           String         @default("active") // active | archived
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions    Subscription[]
  assignedResellers VpnProfileReseller[]

  @@map("vpn_profiles")
}

model Subscription {
  id                String               @id @default(uuid())
  name              String
  clientId          String
  client            VpnClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profileId         String
  profile           VpnProfile           @relation(fields: [profileId], references: [id])
  dataToken         String               @unique // SXB-DATA-XXXX-XXXX-XXXX
  quotaBytes        BigInt               @default(0)
  quotaUsed         BigInt               @default(0)
  durationDays      Int
  deviceLimit       Int                  @default(1)
  startAt           DateTime             @default(now())
  expireAt          DateTime?
  status            String               @default("active") // active | expired | revoked | suspended
  displayProtocol   String?              // Nom commercial : "MTN Protocol", "Orange Protocol"
  technicalProtocol String?              // Protocole technique : "ssh" | "vless" | "trojan"
  lastProvisionAt   DateTime?
  lastSyncAt        DateTime?
  revokedAt         DateTime?
  deviceId          String?
  revokeReason      String?
  createdBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  devices           SubscriptionDevice[]

  @@map("subscriptions")
}

model AppRegistration {
  id          String     @id @default(uuid())
  deviceId    String     @unique
  phone       String?
  platform    String?
  appVersion  String?
  clientId    String?
  client      VpnClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status      String     @default("pending")
  createdAt   DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  @@map("app_registrations")
}

model SubscriptionDevice {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deviceId       String
  activatedAt    DateTime     @default(now())
  lastSeenAt     DateTime?

  @@unique([subscriptionId, deviceId])
  @@map("subscription_devices")
}

model ActivationSession {
  id             String    @id @default(uuid())
  clientId       String
  client         VpnClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deviceId       String
  activationDate DateTime  @default(now())
  expirationDate DateTime?
  lastSync       DateTime  @default(now())
  status         String    @default("active")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clientId, deviceId])
  @@map("activation_sessions")
}
