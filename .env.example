# Application
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://vpnsxb.afrihall.com

# PostgreSQL
DATABASE_URL=postgresql://127.0.0.1:5432/sxb_vpn?schema=public

# JWT — générer chaque valeur avec : openssl rand -hex 48
JWT_SECRET=replace-with-long-random-access-secret
REFRESH_SECRET=replace-with-long-random-refresh-secret

# AES-256 — générer exactement 32 caractères avec : openssl rand -hex 16
ENCRYPTION_KEY=replace-with-32-char-secret-valu

# XPanel / XNet
XPANEL_URL=http://127.0.0.1:18790
XPANEL_ADMIN_USERNAME=admin
XPANEL_ADMIN_PASSWORD=replace_me

# Comptes privilégiés : fournir uniquement à l’exécution des scripts.
# OWNER_EMAIL=
# OWNER_PASSWORD=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
