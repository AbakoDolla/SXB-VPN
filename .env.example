# ── Base ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sxb_vpn?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sxb_vpn

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH: openssl rand -hex 48
JWT_REFRESH_SECRET=GENERATE_WITH: openssl rand -hex 48
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256) ──────────────────────────────────────────────────────
ENCRYPTION_KEY=GENERATE_WITH: openssl rand -hex 16
MOBILE_HEALTH_PSEUDONYM_SECRET=GENERATE_WITH: openssl rand -hex 16

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://vpnsxb.afrihall.com
API_URL=https://vpnsxb.afrihall.com

# ── XPanel / XNet ────────────────────────────────────────────────────────────
XPANEL_URL=http://localhost:18790
XPANEL_ADMIN_USERNAME=admin
XPANEL_ADMIN_PASSWORD=CHANGE_ME
XPANEL_BASE_PATH=/kqUtkMEvgdtx

# ── Compte OWNER (rôle racine, créé via backend/scripts/create-owner.js) ──────
# Jamais commités en clair : fournis à l'exécution sur le VPS uniquement.
# OWNER_EMAIL=
# OWNER_PASSWORD=

# ── Notifications push Firebase Cloud Messaging (optionnel) ──────────────────
# Serveur : préférer le JSON complet dans le gestionnaire de secrets du VPS.
# Ne jamais préfixer ces variables privées par EXPO_PUBLIC_.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Alternative équivalente si le gestionnaire de secrets expose champ par champ :
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
#
# Android : identifiants Firebase publics, lus au prebuild. Si l'un manque,
# l'APK compile normalement et FCM reste désactivé (aucun google-services.json).
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
