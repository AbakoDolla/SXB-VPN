diff --git a/.github/workflows/build-android.yml b/.github/workflows/build-android.yml
index e3ce06a..c8b4531 100644
--- a/.github/workflows/build-android.yml
+++ b/.github/workflows/build-android.yml
@@ -335,16 +335,32 @@ jobs:
             fi
           done
 
+          set +e
           ./gradlew :app:assembleRelease \
             --no-daemon \
             --build-cache \
             --parallel \
             $SKIP_TASKS \
             2>&1 | tee /tmp/gradle-build.log
+          GRADLE_EXIT=${PIPESTATUS[0]}
+          set -e
+
+          # Observabilité : en cas d'échec, publier la cause exacte dans les
+          # annotations du check-run (lisibles via l'API GitHub, contrairement
+          # aux logs complets qui peuvent être inaccessibles hors-session).
+          if [ "$GRADLE_EXIT" -ne 0 ]; then
+            EXCERPT=$(awk '/FAILURE: Build failed/{f=1} f{print} /^> Task .*(FAILED)/{print}' /tmp/gradle-build.log | head -c 4000)
+            if [ -z "$EXCERPT" ]; then
+              EXCERPT=$(grep -E "FAILED|error:|Error:|Exception|ENOENT|A problem occurred" /tmp/gradle-build.log | tail -40 | head -c 4000)
+            fi
+            # 1 annotation ::error par tranche (limite GitHub : ~10 par step)
+            echo "$EXCERPT" | fold -w 900 -s | head -9 | sed 's/^/::error title=Gradle assembleRelease FAILED::/'
+          fi
 
           echo "::group::Gradle output (dernières 100 lignes)"
           tail -100 /tmp/gradle-build.log
           echo "::endgroup::"
+          exit $GRADLE_EXIT
         env:
           NODE_ENV: production
           EXPO_PUBLIC_API_URL: https://vpnsxb.afrihall.com/api
